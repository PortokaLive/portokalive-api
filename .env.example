# PortokaLive API — environment variables
# Copy to .env for local development

# Server
PORT=5000
ENVIRONMENT=development

# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/portokalive

# JWT
SECRET_KEY=change-me-in-production

# api.video
API_VIDEO_URL=https://ws.api.video
API_VIDEO_API_KEY=your-api-video-key

# Client URLs (activation emails)
DEV_CLIENT_URL=http://localhost:3000
PROD_CLIENT_URL=https://portokalive.vercel.app

# Legacy media server (orphaned routes — do not use in new deploys)
DEV_MEDIA_SERVER_URL=
PROD_MEDIA_SERVER_URL=

# Email (Gmail activation)
EMAIL_SENDER=
EMAIL_SENDER_PASSWORD=

# CORS (optional IP allowlist)
WHITELIST_IPS=
